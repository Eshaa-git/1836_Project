// Nourish database schema.
//
// Conventions (see docs/architecture.md):
// - Primary keys are UUIDv7 (time-sortable).
// - Tables and columns are snake_case in Postgres, camelCase in TypeScript.
// - User-owned tables carry a user_id FK and an index that starts with user_id.
// - Nullable nutrient/measurement columns mean UNKNOWN, never zero.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Identity. Managed by Better Auth (src/server/auth); ids are generated by Prisma (UUIDv7).
// Deleting a user cascades to every user-owned table; audit rows are kept without the link.
model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  accounts            Account[]
  auditLogs           AuditLog[]
  profile             UserProfile?
  bodyMeasurements    BodyMeasurement[]
  dietaryRestrictions DietaryRestriction[]
  goals               Goal[]
  goalEvents          GoalEvent[]
  goalMilestones      GoalMilestone[]
  dailyTargets        DailyTarget[]
  customFoods         Food[]
  foodLogEntries      FoodLogEntry[]
  mealSlotMarks       MealSlotMark[]
  dayLogs             DayLog[]
  savedMeals          SavedMeal[]
  hydrationLogs       HydrationLog[]
  sleepLogs           SleepLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Credential or OAuth link. For email/password, providerId = "credential" and
// `password` holds the scrypt hash (never the plain password).
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Short-lived tokens (password reset, email verification).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Auth endpoint rate-limit counters (database-backed so limits hold across server instances).
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

enum AuditActorType {
  USER
  SYSTEM
  AI

  @@map("audit_actor_type")
}

// Append-only record of security- and data-relevant events. When a user is
// deleted, user_id is nulled so the event survives without identifying them.
model AuditLog {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  action     String
  entityType String?        @map("entity_type")
  entityId   String?        @map("entity_id")
  metadata   Json?
  requestId  String?        @map("request_id")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Profile ─────────────────────────────────────────────────────────────────
// Everything beyond the basics (birth date, height, units, timezone) is optional:
// users start simple and add detail when they want more personalised guidance.

enum Sex {
  FEMALE
  MALE
  INTERSEX
  PREFER_NOT_TO_SAY

  @@map("sex")
}

enum MeasurementSystem {
  METRIC
  IMPERIAL

  @@map("measurement_system")
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE

  @@map("activity_level")
}

enum DietType {
  OMNIVORE
  VEGETARIAN
  EGGETARIAN
  VEGAN
  PESCATARIAN
  OTHER

  @@map("diet_type")
}

model UserProfile {
  userId            String            @id @map("user_id") @db.Uuid
  birthDate         DateTime?         @map("birth_date") @db.Date
  sex               Sex?
  heightCm          Decimal?          @map("height_cm") @db.Decimal(5, 1)
  measurementSystem MeasurementSystem @default(METRIC) @map("measurement_system")
  timezone          String            @default("UTC")

  // Food preferences (restrictions live in dietary_restrictions)
  dietType       DietType? @map("diet_type")
  dietTypeOther  String?   @map("diet_type_other")
  cuisines       String[]  @default([])
  preferredFoods String[]  @default([]) @map("preferred_foods")

  // Routine (times are local "HH:MM" strings in the user's timezone)
  activityLevel      ActivityLevel? @map("activity_level")
  mealsPerDay        Int?           @map("meals_per_day") @db.SmallInt
  wakeTime           String?        @map("wake_time")
  bedTime            String?        @map("bed_time")
  workoutTime        String?        @map("workout_time")
  workoutDurationMin Int?           @map("workout_duration_min") @db.SmallInt
  workoutDays        String[]       @default([]) @map("workout_days")
  workSchedule       String?        @map("work_schedule")
  /// Preferred meal times: [{ "label": "Breakfast", "time": "07:30" }, …]
  mealTimes          Json?          @map("meal_times")

  // Motivation
  motivationWhy String? @map("motivation_why")
  roleModel     String? @map("role_model")

  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Append-only body measurements. Nothing is inferred for days without an entry.
model BodyMeasurement {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  measuredAt DateTime @map("measured_at") @db.Timestamptz(3)
  localDate  DateTime @map("local_date") @db.Date
  weightKg   Decimal? @map("weight_kg") @db.Decimal(5, 2)
  bodyFatPct Decimal? @map("body_fat_pct") @db.Decimal(4, 1)
  waistCm    Decimal? @map("waist_cm") @db.Decimal(5, 1)
  hipCm      Decimal? @map("hip_cm") @db.Decimal(5, 1)
  chestCm    Decimal? @map("chest_cm") @db.Decimal(5, 1)
  armCm      Decimal? @map("arm_cm") @db.Decimal(5, 1)
  thighCm    Decimal? @map("thigh_cm") @db.Decimal(5, 1)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
  @@map("body_measurements")
}

// ─── Dietary restrictions ────────────────────────────────────────────────────
// Four categories that are never treated as equivalent. ALLERGY is the highest
// priority and is enforced deterministically before any recommendation.

enum RestrictionKind {
  ALLERGY
  INTOLERANCE
  AVOID
  OTHER

  @@map("restriction_kind")
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN

  @@map("allergy_severity")
}

model DietaryRestriction {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  kind         RestrictionKind
  /// Code from the allergen taxonomy (src/server/domain/dietary/allergens.ts) when one applies.
  allergenCode String?          @map("allergen_code")
  /// What the user called it, e.g. "cashews", "lactose", "pork", "halal only".
  label        String
  severity     AllergySeverity? // allergies only
  note         String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, label])
  @@index([userId, kind])
  @@map("dietary_restrictions")
}

// ─── Goals ───────────────────────────────────────────────────────────────────
// Goals are edited in place but every change is recorded as a GoalEvent, and a
// goal is never deleted: replaced/achieved goals stay in history.

enum GoalType {
  FAT_LOSS
  WEIGHT_LOSS
  MAINTENANCE
  MUSCLE_GAIN
  STRENGTH
  GENERAL_FITNESS

  @@map("goal_type")
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  REPLACED
  ARCHIVED

  @@map("goal_status")
}

enum GoalMetric {
  BODY_WEIGHT_KG
  BODY_FAT_PCT
  WAIST_CM
  WORKOUTS_PER_WEEK
  NONE

  @@map("goal_metric")
}

model Goal {
  id                   String     @id @default(uuid(7)) @db.Uuid
  userId               String     @map("user_id") @db.Uuid
  type                 GoalType
  status               GoalStatus @default(ACTIVE)
  title                String
  metric               GoalMetric @default(NONE)
  startValue           Decimal?   @map("start_value") @db.Decimal(7, 2)
  targetValue          Decimal?   @map("target_value") @db.Decimal(7, 2)
  startDate            DateTime   @map("start_date") @db.Date
  targetDate           DateTime?  @map("target_date") @db.Date
  /// Optional activity goal alongside the transformation goal, e.g. 3 workouts/week.
  workoutsPerWeek      Int?       @map("workouts_per_week") @db.SmallInt
  /// Set when the user proceeded despite a safety warning.
  safetyAcknowledgedAt DateTime?  @map("safety_acknowledged_at") @db.Timestamptz(3)
  achievedAt           DateTime?  @map("achieved_at") @db.Timestamptz(3)
  closedAt             DateTime?  @map("closed_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     GoalEvent[]
  milestones GoalMilestone[]

  @@index([userId, status])
  @@map("goals")
}

enum GoalEventType {
  CREATED
  UPDATED
  TIMELINE_EXTENDED
  ACHIEVED
  REPLACED
  ARCHIVED

  @@map("goal_event_type")
}

model GoalEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  goalId    String        @map("goal_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      GoalEventType
  /// Changed fields: { "targetDate": { "from": "2026-12-01", "to": "2027-01-15" } }
  changes   Json?
  note      String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@index([userId, createdAt])
  @@map("goal_events")
}

model GoalMilestone {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  goalId     String?  @map("goal_id") @db.Uuid
  title      String
  value      Decimal? @db.Decimal(7, 2)
  achievedAt DateTime @map("achieved_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, achievedAt])
  @@map("goal_milestones")
}

// ─── Daily targets ───────────────────────────────────────────────────────────
// User-entered (automatic BMR/TDEE is on HOLD). Append-only: a change closes the
// current row (effective_to) and inserts a new one. NULL means "no target".

enum TargetSource {
  MANUAL

  @@map("target_source")
}

model DailyTarget {
  id                   String       @id @default(uuid(7)) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  source               TargetSource @default(MANUAL)
  caloriesKcal         Int?         @map("calories_kcal")
  proteinG             Decimal?     @map("protein_g") @db.Decimal(6, 1)
  carbsG               Decimal?     @map("carbs_g") @db.Decimal(6, 1)
  fatG                 Decimal?     @map("fat_g") @db.Decimal(6, 1)
  fiberG               Decimal?     @map("fiber_g") @db.Decimal(6, 1)
  waterMl              Int?         @map("water_ml")
  sleepHours           Decimal?     @map("sleep_hours") @db.Decimal(3, 1)
  reason               String?
  /// Safety warnings the user saw and accepted when saving these targets.
  acknowledgedWarnings String[]     @default([]) @map("acknowledged_warnings")
  effectiveFrom        DateTime     @map("effective_from") @db.Timestamptz(3)
  effectiveTo          DateTime?    @map("effective_to") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
  @@map("daily_targets")
}

// ─── Foods ───────────────────────────────────────────────────────────────────
// Reference data (USDA SR Legacy, curated dishes) plus, later, user-created
// foods. Nutrient values are per 100 g; NULL means UNKNOWN, never zero.

enum FoodSource {
  USDA_SR_LEGACY
  CURATED
  USER

  @@map("food_source")
}

enum AllergenAssessment {
  ASSESSED
  UNVERIFIED

  @@map("allergen_assessment")
}

enum AllergenPresence {
  CONTAINS
  MAY_CONTAIN

  @@map("allergen_presence")
}

model Food {
  id                 String             @id @default(uuid(7)) @db.Uuid
  source             FoodSource
  /// Identifier within the source (USDA fdcId, curated slug).
  sourceId           String             @map("source_id")
  sourceVersion      String?            @map("source_version")
  /// Owner for USER foods; NULL for shared reference foods.
  userId             String?            @map("user_id") @db.Uuid
  name               String
  category           String?
  /// Extra names people use ("curd", "toor dal").
  aliases            String[]           @default([])
  /// Lower-cased name + aliases, indexed with pg_trgm for fuzzy search.
  searchText         String             @map("search_text")
  /// Values are approximate (curated dishes, typical recipes).
  isEstimate         Boolean            @default(false) @map("is_estimate")
  /// How the values were derived (e.g. curated recipe ingredients).
  basis              Json?
  allergenAssessment AllergenAssessment @default(UNVERIFIED) @map("allergen_assessment")
  /// Ranking hint for common everyday foods.
  isCommon           Boolean            @default(false) @map("is_common")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nutrition      FoodNutrition?
  portions       FoodPortion[]
  allergens      FoodAllergen[]
  foodLogEntries FoodLogEntry[]
  savedMealItems SavedMealItem[]

  @@unique([source, sourceId])
  @@index([userId])
  @@map("foods")
}

model FoodNutrition {
  foodId        String @id @map("food_id") @db.Uuid
  energyKcal    Float? @map("energy_kcal")
  proteinG      Float? @map("protein_g")
  carbsG        Float? @map("carbs_g")
  fatG          Float? @map("fat_g")
  fiberG        Float? @map("fiber_g")
  sugarsG       Float? @map("sugars_g")
  saturatedFatG Float? @map("saturated_fat_g")
  cholesterolMg Float? @map("cholesterol_mg")
  sodiumMg      Float? @map("sodium_mg")
  potassiumMg   Float? @map("potassium_mg")
  calciumMg     Float? @map("calcium_mg")
  ironMg        Float? @map("iron_mg")
  magnesiumMg   Float? @map("magnesium_mg")
  zincMg        Float? @map("zinc_mg")
  vitaminAMcg   Float? @map("vitamin_a_mcg")
  vitaminCMg    Float? @map("vitamin_c_mg")
  vitaminDMcg   Float? @map("vitamin_d_mcg")
  vitaminB12Mcg Float? @map("vitamin_b12_mcg")
  folateMcg     Float? @map("folate_mcg")

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@map("food_nutrition")
}

model FoodPortion {
  id         String  @id @default(uuid(7)) @db.Uuid
  foodId     String  @map("food_id") @db.Uuid
  /// Normalized unit: cup, tbsp, medium, slice, piece, bowl…
  unit       String
  amount     Float
  gramWeight Float   @map("gram_weight")
  label      String
  isEstimate Boolean @default(false) @map("is_estimate")
  sortOrder  Int     @default(0) @map("sort_order")

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
  @@map("food_portions")
}

model FoodAllergen {
  foodId       String           @map("food_id") @db.Uuid
  allergenCode String           @map("allergen_code")
  presence     AllergenPresence @default(CONTAINS)

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([foodId, allergenCode])
  @@index([allergenCode])
  @@map("food_allergens")
}

// ─── Food logging ────────────────────────────────────────────────────────────
// Only logged entries count as eaten. Each entry snapshots the nutrients at the
// time of logging (NULL = unknown), so catalog updates never rewrite history.

enum LogSource {
  MANUAL
  SAVED_MEAL
  COPY
  CHAT

  @@map("log_source")
}

model FoodLogEntry {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Calendar day in the user's timezone.
  localDate     DateTime  @map("local_date") @db.Date
  /// When it was eaten.
  eatenAt       DateTime  @map("eaten_at") @db.Timestamptz(3)
  /// Meal slot label, e.g. "Breakfast", "Snack 2".
  mealSlot      String    @map("meal_slot")
  foodId        String?   @map("food_id") @db.Uuid
  foodName      String    @map("food_name")
  quantity      Float
  /// Normalized unit ("g", "cup", "piece") or "portion" when a food portion was chosen.
  unit          String
  portionLabel  String?   @map("portion_label")
  grams         Float
  isEstimate    Boolean   @default(false) @map("is_estimate")
  estimateNote  String?   @map("estimate_note")
  source        LogSource @default(MANUAL)
  note          String?
  energyKcal    Float?    @map("energy_kcal")
  proteinG      Float?    @map("protein_g")
  carbsG        Float?    @map("carbs_g")
  fatG          Float?    @map("fat_g")
  fiberG        Float?    @map("fiber_g")
  sugarsG       Float?    @map("sugars_g")
  saturatedFatG Float?    @map("saturated_fat_g")
  cholesterolMg Float?    @map("cholesterol_mg")
  sodiumMg      Float?    @map("sodium_mg")
  potassiumMg   Float?    @map("potassium_mg")
  calciumMg     Float?    @map("calcium_mg")
  ironMg        Float?    @map("iron_mg")
  magnesiumMg   Float?    @map("magnesium_mg")
  zincMg        Float?    @map("zinc_mg")
  vitaminAMcg   Float?    @map("vitamin_a_mcg")
  vitaminCMg    Float?    @map("vitamin_c_mg")
  vitaminDMcg   Float?    @map("vitamin_d_mcg")
  vitaminB12Mcg Float?    @map("vitamin_b12_mcg")
  folateMcg     Float?    @map("folate_mcg")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId, localDate])
  @@index([userId, eatenAt])
  @@map("food_log_entries")
}

enum MealMark {
  SKIPPED

  @@map("meal_mark")
}

/// Explicit "I skipped this meal". Absence of entries alone never means skipped.
model MealSlotMark {
  userId    String   @map("user_id") @db.Uuid
  localDate DateTime @map("local_date") @db.Date
  mealSlot  String   @map("meal_slot")
  mark      MealMark
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, localDate, mealSlot])
  @@map("meal_slot_marks")
}

/// Per-day flags. "Complete" is the user saying they've logged everything.
model DayLog {
  userId      String    @map("user_id") @db.Uuid
  localDate   DateTime  @map("local_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, localDate])
  @@map("day_logs")
}

model SavedMeal {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  defaultSlot String?   @map("default_slot")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedMealItem[]

  @@index([userId])
  @@map("saved_meals")
}

model SavedMealItem {
  id           String  @id @default(uuid(7)) @db.Uuid
  savedMealId  String  @map("saved_meal_id") @db.Uuid
  foodId       String? @map("food_id") @db.Uuid
  foodName     String  @map("food_name")
  quantity     Float
  unit         String
  portionLabel String? @map("portion_label")
  grams        Float
  isEstimate   Boolean @default(false) @map("is_estimate")
  sortOrder    Int     @default(0) @map("sort_order")

  savedMeal SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  food      Food?     @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([savedMealId])
  @@map("saved_meal_items")
}

// ─── Hydration and sleep ─────────────────────────────────────────────────────

model HydrationLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  localDate DateTime @map("local_date") @db.Date
  loggedAt  DateTime @map("logged_at") @db.Timestamptz(3)
  amountMl  Int      @map("amount_ml")
  drink     String   @default("Water")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
  @@map("hydration_logs")
}

/// Main sleep that ended on `localDate` (the morning you woke up).
model SleepLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  localDate   DateTime  @map("local_date") @db.Date
  bedtimeAt   DateTime? @map("bedtime_at") @db.Timestamptz(3)
  wokeAt      DateTime? @map("woke_at") @db.Timestamptz(3)
  durationMin Int       @map("duration_min")
  quality     Int?      @db.SmallInt
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@map("sleep_logs")
}
