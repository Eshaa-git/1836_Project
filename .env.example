# Copy to .env (development) and .env.test (tests). Never commit real secrets.

# PostgreSQL connection. `npm run db:start` serves both databases below on port 54329.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/nourish_dev"

# Public base URL of the app (used for links in emails, auth callbacks).
APP_URL="http://localhost:3000"

# trace | debug | info | warn | error | fatal
LOG_LEVEL="debug"
