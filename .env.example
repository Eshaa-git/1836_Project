# Copy to .env (development) and .env.test (tests). Never commit real secrets.

# PostgreSQL connection. `npm run db:start` serves both databases below on port 54329.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/nourish_dev"

# Public base URL of the app (used for links in emails, auth callbacks).
APP_URL="http://localhost:3000"

# Session/token signing secret, at least 32 characters. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-secret-value"

# Auth rate limiting: "on" | "off". Defaults to on everywhere except `next dev`.
# AUTH_RATE_LIMIT="on"

# Email delivery: "console" logs emails (development/tests). Production providers come later.
EMAIL_TRANSPORT="console"
EMAIL_FROM="Nourish <no-reply@localhost>"

# trace | debug | info | warn | error | fatal
LOG_LEVEL="debug"
